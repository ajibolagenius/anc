; systemd unit for the ANC WhatsApp bot on the Oracle Cloud Always Free VM.
;
; Install:
;   sudo cp anc-wa-bot.service /etc/systemd/system/anc-wa-bot.service
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now anc-wa-bot
;
; First run needs an interactive terminal to scan the pairing QR code:
;   sudo systemctl stop anc-wa-bot
;   cd /opt/anc && pnpm --filter @anc/wa-bot start   # scan QR, Ctrl+C once connected
;   sudo systemctl start anc-wa-bot                  # session is now persisted in apps/wa-bot/auth

[Unit]
Description=ANC WhatsApp bot (Baileys)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anc
WorkingDirectory=/opt/anc
EnvironmentFile=/opt/anc/apps/wa-bot/.env
ExecStart=/usr/bin/pnpm --filter @anc/wa-bot start
Restart=on-failure
RestartSec=5

; Sandboxing: if a dependency (baileys, pino, qrcode-terminal, ...) is ever
; compromised via a supply-chain attack, these limit what the process can do
; beyond its own working files.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/anc/apps/wa-bot/auth
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
