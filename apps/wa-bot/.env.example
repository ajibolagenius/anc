# The ANC WhatsApp group's JID (already known — see PRD.md §5)
WA_GROUP_JID=120363206409553106@g.us

# Shared secret — must match WA_BOT_INTERNAL_KEY on the apps/web side
WA_BOT_INTERNAL_KEY=

# Optional
PORT=8787
WA_AUTH_DIR=./auth
LOG_LEVEL=warn

# Sentry error monitoring (optional — unset means monitoring is a no-op).
# Alerts on unhandled errors and, most importantly, on a "logged out"
# disconnect (the one failure mode that needs a human to re-scan the QR code).
SENTRY_DSN=
